{
    "openapi": "3.0.0",
    "info": {
        "title": "Tech Solutions - API de Gestión de Proyectos",
        "description": "API REST para la gestión de proyectos de Tech Solutions.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Servidor local de desarrollo"
        }
    ],
    "paths": {
        "/api/projects": {
            "get": {
                "tags": [
                    "Proyectos"
                ],
                "summary": "Listar proyectos",
                "description": "Obtiene todos los proyectos pertenecientes al usuario autenticado.",
                "operationId": "8d4a13ef3fc773ff4031e515460919ea",
                "responses": {
                    "200": {
                        "description": "Lista de proyectos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "nombre": {
                                                "type": "string",
                                                "example": "Sistema Web"
                                            },
                                            "fecha_inicio": {
                                                "type": "string",
                                                "format": "date",
                                                "example": "2026-09-10"
                                            },
                                            "estado": {
                                                "type": "string",
                                                "example": "En progreso"
                                            },
                                            "responsable": {
                                                "type": "string",
                                                "example": "Juan Pérez"
                                            },
                                            "monto": {
                                                "type": "number",
                                                "format": "float",
                                                "example": 1500000
                                            },
                                            "created_by": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "created_at": {
                                                "type": "string",
                                                "format": "date-time"
                                            },
                                            "updated_at": {
                                                "type": "string",
                                                "format": "date-time"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Proyectos"
                ],
                "summary": "Crear proyecto",
                "description": "Crea un nuevo proyecto asociado al usuario autenticado.",
                "operationId": "a4dd4c17bf5fc24c224357f03dcc848a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nombre",
                                    "fecha_inicio",
                                    "estado",
                                    "responsable",
                                    "monto"
                                ],
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Sistema de Gestión"
                                    },
                                    "fecha_inicio": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-09-10"
                                    },
                                    "estado": {
                                        "type": "string",
                                        "example": "En progreso"
                                    },
                                    "responsable": {
                                        "type": "string",
                                        "example": "Juan Pérez"
                                    },
                                    "monto": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 1500000
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Proyecto creado correctamente"
                    },
                    "422": {
                        "description": "Datos de entrada inválidos"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/projects/{project}": {
            "get": {
                "tags": [
                    "Proyectos"
                ],
                "summary": "Obtener proyecto por ID",
                "description": "Obtiene un proyecto específico por su identificador.",
                "operationId": "1352e06e55f6ab10d3702509cd385918",
                "parameters": [
                    {
                        "name": "project",
                        "in": "path",
                        "description": "ID del proyecto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Proyecto encontrado"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permiso para acceder al proyecto"
                    },
                    "404": {
                        "description": "Proyecto no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Proyectos"
                ],
                "summary": "Actualizar proyecto",
                "description": "Actualiza los datos de un proyecto existente.",
                "operationId": "a93b65e3037bfd5ea5cdc1b3dd11ba53",
                "parameters": [
                    {
                        "name": "project",
                        "in": "path",
                        "description": "ID del proyecto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Sistema actualizado"
                                    },
                                    "fecha_inicio": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-09-10"
                                    },
                                    "estado": {
                                        "type": "string",
                                        "example": "Finalizado"
                                    },
                                    "responsable": {
                                        "type": "string",
                                        "example": "Juan Pérez"
                                    },
                                    "monto": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 2000000
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Proyecto actualizado correctamente"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permiso para modificar el proyecto"
                    },
                    "404": {
                        "description": "Proyecto no encontrado"
                    },
                    "422": {
                        "description": "Datos de entrada inválidos"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Proyectos"
                ],
                "summary": "Eliminar proyecto",
                "description": "Elimina un proyecto existente.",
                "operationId": "63c289a907902132dd95dd7ecb50143f",
                "parameters": [
                    {
                        "name": "project",
                        "in": "path",
                        "description": "ID del proyecto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Proyecto eliminado correctamente"
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Sin permiso para eliminar el proyecto"
                    },
                    "404": {
                        "description": "Proyecto no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "patch": {
                "tags": [
                    "Proyectos"
                ],
                "summary": "Actualizar parcialmente un proyecto",
                "description": "Actualiza parcialmente los datos de un proyecto existente.",
                "operationId": "ee35632abc0168537257bd8f5baa9f30",
                "parameters": [
                    {
                        "name": "project",
                        "in": "path",
                        "description": "ID del proyecto",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nombre": {
                                        "type": "string",
                                        "example": "Sistema actualizado"
                                    },
                                    "fecha_inicio": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-09-10"
                                    },
                                    "estado": {
                                        "type": "string",
                                        "example": "Finalizado"
                                    },
                                    "responsable": {
                                        "type": "string",
                                        "example": "Juan Pérez"
                                    },
                                    "monto": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 2000000
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Proyecto actualizado correctamente"
                    },
                    "404": {
                        "description": "Proyecto no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Proyectos",
